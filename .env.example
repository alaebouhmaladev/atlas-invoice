# Atlas CRM - Environment Configuration Example
# Copy this file to .env and fill in secure credentials before running the application.
# NEVER commit the actual .env file to version control.

NODE_ENV=development
APP_NAME="Atlas CRM"
APP_URL=http://localhost:3000

# PostgreSQL Configuration
POSTGRES_DB=atlas_bites_facturation
POSTGRES_USER=atlas_user
POSTGRES_PASSWORD=change_this_password_in_production

# Application running inside Docker
DATABASE_URL=postgresql://atlas_user:change_this_password_in_production@db:5432/atlas_bites_facturation?schema=public

# Optional host-side tools (e.g. running Prisma or Vitest directly on host)
DATABASE_URL_HOST=postgresql://atlas_user:change_this_password_in_production@localhost:5436/atlas_bites_facturation?schema=public

# Session Secret (Minimum 32 random characters)
# How to generate a strong secret:
# Linux/macOS command: openssl rand -hex 32
# Node.js command: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_at_least_32_random_characters_secret_key_atlas
SESSION_MAX_AGE=604800

# Super Admin Initial Seed Credentials
# Required for running 'pnpm db:seed'
# Password must be at least 12 characters and include uppercase, lowercase, number, and special character
SUPER_ADMIN_NAME="System Administrator"
SUPER_ADMIN_EMAIL="admin@atlasbites.ma"
SUPER_ADMIN_PASSWORD="ChangeMeAtlas2026!"
