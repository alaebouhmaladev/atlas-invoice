  submittedById         String?
  submittedAt           DateTime?
  approvedById          String?
  approvedAt            DateTime?
  rejectionReason       String?
  idempotencyKey        String
  version               Int                   @default(1)
  createdById           String
  updatedById           String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  period              PayrollPeriod             @relation(fields: [periodId], references: [id], onDelete: Restrict)
  componentDefinition SalaryComponentDefinition @relation(fields: [componentDefinitionId], references: [id], onDelete: Restrict)

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, periodId, employeeId, status])
}

model EmployeeAdvance {
  id                   String            @id @default(uuid())
  tenantId             String
  employeeId           String
  reference            String
  originalAmount       Decimal           @db.Decimal(14, 2)
  paidAmount           Decimal           @default(0) @db.Decimal(14, 2)
  remainingAmount      Decimal           @db.Decimal(14, 2)
  disbursementDate     DateTime
  repaymentStart       DateTime
  installmentAmount    Decimal           @db.Decimal(14, 2)
  status               PayrollDebtStatus @default(DRAFT)
  supportingDocumentId String?
  approvedById         String?
  approvedAt           DateTime?
  reason               String?
  version              Int               @default(1)
  createdById          String
  updatedById          String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@unique([tenantId, reference])
  @@index([tenantId, employeeId, status])
}

model EmployeeLoan {
  id                   String            @id @default(uuid())
  tenantId             String
  employeeId           String
  reference            String
  originalAmount       Decimal           @db.Decimal(14, 2)
  paidAmount           Decimal           @default(0) @db.Decimal(14, 2)
  remainingAmount      Decimal           @db.Decimal(14, 2)
  disbursementDate     DateTime
  repaymentStart       DateTime
  installmentAmount    Decimal           @db.Decimal(14, 2)
  installmentCount     Int
  status               PayrollDebtStatus @default(DRAFT)
  supportingDocumentId String?
  approvedById         String?
  approvedAt           DateTime?
  suspendedAt          DateTime?
  settledAt            DateTime?
  reason               String?
  version              Int               @default(1)
  createdById          String
  updatedById          String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  installments EmployeeLoanInstallment[]

  @@unique([tenantId, reference])
  @@index([tenantId, employeeId, status])
}

model EmployeeLoanInstallment {
  id              String    @id @default(uuid())
  tenantId        String
  loanId          String
  payrollRecordId String?
  installmentNo   Int
  dueDate         DateTime
  amount          Decimal   @db.Decimal(14, 2)
  deductedAt      DateTime?
  status          String    @default("SCHEDULED")
  createdAt       DateTime  @default(now())

  loan EmployeeLoan @relation(fields: [loanId], references: [id], onDelete: Restrict)

  @@unique([tenantId, loanId, installmentNo])
  @@unique([tenantId, payrollRecordId, loanId])
  @@index([tenantId, dueDate, status])
}

model PayrollRecord {
  id                     String              @id @default(uuid())
  tenantId               String
  periodId               String
  employeeId             String
  employeeNumberSnapshot String
  employeeNameSnapshot   String
  siteSnapshot           String?
  departmentSnapshot     String?
  positionSnapshot       String?
  contractSnapshot       Json
  bankSnapshotEncrypted  String?
  bankMaskedSnapshot     String?
  baseSalarySnapshot     Decimal             @db.Decimal(14, 2)
  workedTimeSnapshot     Json
  leaveSnapshot          Json
  sourceSnapshot         Json
  prorationMethod        String
  grossSalary            Decimal             @db.Decimal(14, 2)
  taxableGross           Decimal             @db.Decimal(14, 2)
  contributionBase       Decimal             @db.Decimal(14, 2)
  employeeContributions  Decimal             @db.Decimal(14, 2)
  employerContributions  Decimal             @db.Decimal(14, 2)
  taxableNet             Decimal             @db.Decimal(14, 2)
  incomeTax              Decimal             @db.Decimal(14, 2)
  totalDeductions        Decimal             @db.Decimal(14, 2)
  netPayable             Decimal             @db.Decimal(14, 2)
  employerCost           Decimal             @db.Decimal(14, 2)
  status                 PayrollRecordStatus @default(DRAFT)
  calculationHash        String
  calculatedAt           DateTime
  version                Int                 @default(1)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  period   PayrollPeriod  @relation(fields: [periodId], references: [id], onDelete: Restrict)
  lines    PayrollLine[]
  payslips PayslipAsset[]

  @@unique([tenantId, periodId, employeeId])
  @@index([tenantId, employeeId, status])
}

model PayrollLine {
  id                     String               @id @default(uuid())
  tenantId               String
  recordId               String
  componentCodeSnapshot  String
  componentNameSnapshot  String
  kind                   PayrollComponentKind
  quantity               Decimal?             @db.Decimal(14, 4)
  rate                   Decimal?             @db.Decimal(14, 6)
  calculationBase        Decimal?             @db.Decimal(14, 2)
  employeeAmount         Decimal              @default(0) @db.Decimal(14, 2)
  employerAmount         Decimal              @default(0) @db.Decimal(14, 2)
  taxable                Boolean              @default(false)
  cnssApplicable         Boolean              @default(false)
  amoApplicable          Boolean              @default(false)
  source                 String
  sourceEntityId         String?
  calculationOrder       Int
  calculationExplanation Json
  createdAt              DateTime             @default(now())

  record PayrollRecord @relation(fields: [recordId], references: [id], onDelete: Restrict)

  @@index([tenantId, recordId, calculationOrder])
}

model PayrollCalculationRun {
  id            String           @id @default(uuid())
  tenantId      String
  periodId      String
  runNumber     Int
  status        PayrollRunStatus @default(RUNNING)
  startedById   String
  startedAt     DateTime         @default(now())
  finishedAt    DateTime?
  employeeCount Int              @default(0)
  successCount  Int              @default(0)
  failureCount  Int              @default(0)
  inputHash     String?
  outputHash    String?
  errorSummary  Json?

  period PayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Restrict)

  @@unique([tenantId, periodId, runNumber])
  @@index([tenantId, status, startedAt])
}

model PayrollHistory {
  id                String               @id @default(uuid())
  tenantId          String
  periodId          String
  recordId          String?
  action            PayrollHistoryAction
  actorId           String
  actorNameSnapshot String
  actorRoleSnapshot String
  reason            String?
  beforeSnapshot    Json?
  afterSnapshot     Json?
  requestId         String
  calculationHash   String?
  createdAt         DateTime             @default(now())

  period PayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Restrict)

  @@unique([tenantId, requestId, action])
  @@index([tenantId, periodId, createdAt])
}

model PayslipAsset {
  id              String    @id @default(uuid())
  tenantId        String
  payrollRecordId String
  assetId         String
  payslipNumber   String
  versionNumber   Int
  sha256          String
  generatedById   String
  generatedAt     DateTime  @default(now())
  supersededAt    DateTime?

  payrollRecord PayrollRecord @relation(fields: [payrollRecordId], references: [id], onDelete: Restrict)

  @@unique([tenantId, payrollRecordId, versionNumber])
  @@unique([tenantId, payslipNumber])
  @@index([tenantId, assetId])
}
