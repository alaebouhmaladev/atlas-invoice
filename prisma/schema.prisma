generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  HR_MANAGER
  ACCOUNTANT
  COMMERCIAL
}

enum ClientType {
  COMPANY
  INDIVIDUAL
}

model User {
  id                 String    @id @default(uuid())
  tenantId           String    @default("default-tenant")
  name               String
  email              String    @unique
  passwordHash       String
  role               Role
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  passwordChangedAt  DateTime?
  deactivatedAt      DateTime?
  deactivatedById    String?
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  deactivatedBy    User?  @relation("UserDeactivatedBy", fields: [deactivatedById], references: [id])
  deactivatedUsers User[] @relation("UserDeactivatedBy")

  sessions                 Session[]
  auditLogs                AuditLog[]
  createdClients           Client[]                  @relation("ClientCreatedBy")
  updatedClients           Client[]                  @relation("ClientUpdatedBy")
  createdQuotes            Quote[]                   @relation("QuoteCreatedBy")
  updatedQuotes            Quote[]                   @relation("QuoteUpdatedBy")
  createdInvoices          Invoice[]                 @relation("InvoiceCreatedBy")
  updatedInvoices          Invoice[]                 @relation("InvoiceUpdatedBy")
  cancelledInvoices        Invoice[]                 @relation("InvoiceCancelledBy")
  archivedInvoices         Invoice[]                 @relation("InvoiceArchivedBy")
  archivedQuotes           Quote[]                   @relation("QuoteArchivedBy")
  createdPayments          Payment[]                 @relation("PaymentCreatedBy")
  reversedPayments         Payment[]                 @relation("PaymentReversedBy")
  uploadedAssets           CompanyAsset[]            @relation("AssetUploadedBy")
  updatedSettings          CompanySettings[]         @relation("SettingsUpdatedBy")
  notifications            AppNotification[]         @relation("UserNotifications")
  employee                 Employee?                 @relation("UserEmployee")
  createdEmployees         Employee[]                @relation("EmployeeCreatedBy")
  updatedEmployees         Employee[]                @relation("EmployeeUpdatedBy")
  archivedEmployees        Employee[]                @relation("EmployeeArchivedBy")
  createdSites             WorkSite[]                @relation("WorkSiteCreatedBy")
  updatedSites             WorkSite[]                @relation("WorkSiteUpdatedBy")
  archivedSites            WorkSite[]                @relation("WorkSiteArchivedBy")
  createdDepartments       Department[]              @relation("DepartmentCreatedBy")
  updatedDepartments       Department[]              @relation("DepartmentUpdatedBy")
  archivedDepartments      Department[]              @relation("DepartmentArchivedBy")
  createdPositions         Position[]                @relation("PositionCreatedBy")
  updatedPositions         Position[]                @relation("PositionUpdatedBy")
  archivedPositions        Position[]                @relation("PositionArchivedBy")
  createdAssignments       EmployeeAssignment[]      @relation("AssignmentCreatedBy")
  endedAssignments         EmployeeAssignment[]      @relation("AssignmentEndedBy")
  createdContracts         EmploymentContract[]      @relation("ContractCreatedBy")
  updatedContracts         EmploymentContract[]      @relation("ContractUpdatedBy")
  createdDocuments         EmployeeDocument[]        @relation("DocumentCreatedBy")
  updatedDocuments         EmployeeDocument[]        @relation("DocumentUpdatedBy")
  archivedDocuments        EmployeeDocument[]        @relation("DocumentArchivedBy")
  uploadedDocumentVersions EmployeeDocumentVersion[] @relation("DocumentVersionUploadedBy")

  createdShiftTemplates     ShiftTemplate[]               @relation("ShiftTemplateCreatedBy")
  updatedShiftTemplates     ShiftTemplate[]               @relation("ShiftTemplateUpdatedBy")
  archivedShiftTemplates    ShiftTemplate[]               @relation("ShiftTemplateArchivedBy")
  publishedSchedules        WorkSchedule[]                @relation("SchedulePublishedBy")
  createdSchedules          WorkSchedule[]                @relation("ScheduleCreatedBy")
  updatedSchedules          WorkSchedule[]                @relation("ScheduleUpdatedBy")
  createdShifts             ScheduledShift[]              @relation("ShiftCreatedBy")
  updatedShifts             ScheduledShift[]              @relation("ShiftUpdatedBy")
  createdStaffingReqs       StaffingRequirement[]         @relation("StaffingReqCreatedBy")
  createdAvailabilities     EmployeeAvailability[]        @relation("AvailabilityCreatedBy")
  scheduleChanges           ScheduleChangeHistory[]       @relation("ScheduleChangeBy")
  updatedSchedulePolicies   SiteSchedulePolicy[]          @relation("SchedulePolicyUpdatedBy")
  createdAttendancePolicies AttendancePolicy[]            @relation("AttendancePolicyCreatedBy")
  updatedAttendancePolicies AttendancePolicy[]            @relation("AttendancePolicyUpdatedBy")
  createdTerminals          AttendanceTerminal[]          @relation("TerminalCreatedBy")
  updatedTerminals          AttendanceTerminal[]          @relation("TerminalUpdatedBy")
  revokedTerminals          AttendanceTerminal[]          @relation("TerminalRevokedBy")
  createdAttendanceEvents   AttendanceEvent[]             @relation("AttendanceEventCreatedBy")
  resolvedAnomalies         AttendanceAnomaly[]           @relation("AnomalyResolvedBy")
  requestedCorrections      AttendanceCorrectionRequest[] @relation("CorrectionRequestedBy")
  reviewedCorrections       AttendanceCorrectionRequest[] @relation("CorrectionReviewedBy")
  correctionHistories       AttendanceCorrectionHistory[] @relation("CorrectionHistoryActor")
  createdValidations        AttendanceValidation[]        @relation("ValidationCreatedBy")
  lockedPeriods             AttendancePeriodLock[]        @relation("PeriodLockedBy")
  unlockedPeriods           AttendancePeriodLock[]        @relation("PeriodUnlockedBy")
  createdLeaveTypes         LeaveType[]                   @relation("LeaveTypeCreatedBy")
  updatedLeaveTypes         LeaveType[]                   @relation("LeaveTypeUpdatedBy")
  createdLeavePolicies      LeavePolicy[]                 @relation("LeavePolicyCreatedBy")
  updatedLeavePolicies      LeavePolicy[]                 @relation("LeavePolicyUpdatedBy")
  submittedLeaveRequests    LeaveRequest[]                @relation("LeaveRequestSubmittedBy")
  cancelledLeaveRequests    LeaveRequest[]                @relation("LeaveRequestCancelledBy")
  assignedLeaveApprovals    LeaveApprovalStep[]           @relation("LeaveApprovalAssignedUser")
  decidedLeaveApprovals     LeaveApprovalStep[]           @relation("LeaveApprovalDecisionBy")
  leaveRequestHistories     LeaveRequestHistory[]         @relation("LeaveRequestHistoryActor")
  leaveBalanceEntries       LeaveBalanceEntry[]           @relation("LeaveBalanceEntryActor")
  createdHolidayCalendars   HolidayCalendar[]             @relation("HolidayCalendarCreatedBy")
  updatedHolidayCalendars   HolidayCalendar[]             @relation("HolidayCalendarUpdatedBy")
  createdHolidays           Holiday[]                     @relation("HolidayCreatedBy")
  updatedHolidays           Holiday[]                     @relation("HolidayUpdatedBy")
  resolvedAbsences          AbsenceRecord[]               @relation("AbsenceResolvedBy")
  archivedLeaveTypes        LeaveType[]                   @relation("LeaveTypeArchivedBy")
  leaveAttachmentsUploaded  LeaveRequestAttachment[]      @relation("LeaveAttachmentUploadedBy")

  @@index([tenantId])
  @@index([email])
  @@index([role])
}

enum NotificationSeverity {
  INFO
  SUCCESS
  WARNING
  CRITICAL
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id                       String   @id @default(uuid())
  userId                   String?
  actorDisplayNameSnapshot String?
  actorRoleSnapshot        Role?
  action                   String
  category                 String   @default("GENERAL")
  result                   String   @default("SUCCESS")
  entityType               String?
  entityId                 String?
  entityReference          String?
  metadata                 Json?
  changedFields            Json?
  requestId                String?
  ipAddress                String?
  userAgent                String?
  createdAt                DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([category])
  @@index([result])
  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
  @@index([userId])
  @@index([action, createdAt])
  @@index([category, createdAt])
}

model AppNotification {
  id               String               @id @default(uuid())
  recipientUserId  String?
  recipientRole    Role?
  type             String
  severity         NotificationSeverity @default(INFO)
  title            String
  message          String
  actionUrl        String?
  entityType       String?
  entityId         String?
  isRead           Boolean              @default(false)
  readAt           DateTime?
  deduplicationKey String?
  createdAt        DateTime             @default(now())
  expiresAt        DateTime?

  recipientUser User? @relation("UserNotifications", fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@index([recipientUserId, isRead, createdAt])
  @@index([recipientRole, isRead, createdAt])
  @@index([deduplicationKey])
  @@index([severity, createdAt])
}

model Client {
  id              String     @id @default(uuid())
  type            ClientType @default(COMPANY)
  companyName     String?
  firstName       String?
  lastName        String?
  displayName     String
  ice             String?
  taxId           String?
  rc              String?
  cnss            String?
  patent          String?
  email           String?
  phone           String?
  secondaryPhone  String?
  address         String?
  addressLine2    String?
  city            String?
  postalCode      String?
  country         String     @default("Maroc")
  contactName     String?
  contactPosition String?
  contactEmail    String?
  contactPhone    String?
  notes           String?
  isArchived      Boolean    @default(false)
  archivedAt      DateTime?
  createdById     String
  updatedById     String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  createdBy User      @relation("ClientCreatedBy", fields: [createdById], references: [id])
  updatedBy User?     @relation("ClientUpdatedBy", fields: [updatedById], references: [id])
  quotes    Quote[]
  invoices  Invoice[]

  @@index([displayName])
  @@index([companyName])
  @@index([firstName])
  @@index([lastName])
  @@index([ice])
  @@index([taxId])
  @@index([email])
  @@index([phone])
  @@index([city])
  @@index([isArchived])
  @@index([createdAt])
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

model Quote {
  id             String @id @default(uuid())
  number         String @unique
  sequenceNumber Int
  sequenceYear   Int

  clientId        String
  clientSnapshot  Json
  companySnapshot Json?

  status QuoteStatus @default(DRAFT)

  issueDate  DateTime
  validUntil DateTime

  currency       String   @default("MAD")
  defaultVatRate Decimal? @db.Decimal(5, 2)

  discountType  DiscountType?
  discountValue Decimal?      @db.Decimal(12, 2)

  subtotalHt     Decimal @db.Decimal(14, 2)
  discountAmount Decimal @default(0) @db.Decimal(14, 2)
  totalNetHt     Decimal @db.Decimal(14, 2)
  totalVat       Decimal @db.Decimal(14, 2)
  totalTtc       Decimal @db.Decimal(14, 2)

  subject       String?
  paymentTerms  String?
  publicNotes   String?
  internalNotes String?

  isArchived    Boolean   @default(false)
  archivedAt    DateTime?
  archivedById  String?
  archiveReason String?

  sentAt      DateTime?
  acceptedAt  DateTime?
  rejectedAt  DateTime?
  expiredAt   DateTime?
  convertedAt DateTime?

  createdById String
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client     Client      @relation(fields: [clientId], references: [id])
  items      QuoteItem[]
  invoice    Invoice?    @relation("QuoteToInvoice")
  createdBy  User        @relation("QuoteCreatedBy", fields: [createdById], references: [id])
  updatedBy  User?       @relation("QuoteUpdatedBy", fields: [updatedById], references: [id])
  archivedBy User?       @relation("QuoteArchivedBy", fields: [archivedById], references: [id])

  @@unique([sequenceYear, sequenceNumber])
  @@index([clientId])
  @@index([status])
  @@index([issueDate])
  @@index([validUntil])
  @@index([isArchived])
  @@index([createdAt])
}

model QuoteItem {
  id       String @id @default(uuid())
  quoteId  String
  position Int

  title        String
  description  String?
  quantity     Decimal @db.Decimal(12, 3)
  unit         String
  unitPriceHt  Decimal @db.Decimal(14, 2)
  discountRate Decimal @default(0) @db.Decimal(5, 2)
  vatRate      Decimal @default(20) @db.Decimal(5, 2)

  grossAmountHt  Decimal @db.Decimal(14, 2)
  discountAmount Decimal @db.Decimal(14, 2)
  netAmountHt    Decimal @db.Decimal(14, 2)
  vatAmount      Decimal @db.Decimal(14, 2)
  totalTtc       Decimal @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@unique([quoteId, position])
  @@index([quoteId])
}

enum InvoiceStatus {
  DRAFT
  FINALIZED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHEQUE
  CARD
  OTHER
}

enum PaymentRecordStatus {
  CONFIRMED
  REVERSED
}

model Invoice {
  id String @id @default(uuid())

  number         String? @unique
  sequenceNumber Int?
  sequenceYear   Int?

  clientId      String
  sourceQuoteId String? @unique

  status        InvoiceStatus @default(DRAFT)
  paymentStatus PaymentStatus @default(UNPAID)

  issueDate DateTime
  dueDate   DateTime

  currency        String @default("MAD")
  clientSnapshot  Json
  companySnapshot Json

  discountType  DiscountType?
  discountValue Decimal?      @db.Decimal(12, 2)

  subtotalHt     Decimal @db.Decimal(14, 2)
  discountAmount Decimal @default(0) @db.Decimal(14, 2)
  totalNetHt     Decimal @db.Decimal(14, 2)
  totalVat       Decimal @db.Decimal(14, 2)
  totalTtc       Decimal @db.Decimal(14, 2)

  amountPaid Decimal @default(0) @db.Decimal(14, 2)
  amountDue  Decimal @db.Decimal(14, 2)

  subject       String?
  paymentTerms  String?
  publicNotes   String?
  internalNotes String?

  finalizedAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  cancelledById      String?

  paidAt DateTime?

  isArchived    Boolean   @default(false)
  archivedAt    DateTime?
  archivedById  String?
  archiveReason String?

  createdById String
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client      Client        @relation(fields: [clientId], references: [id])
  sourceQuote Quote?        @relation("QuoteToInvoice", fields: [sourceQuoteId], references: [id])
  items       InvoiceItem[]
  payments    Payment[]

  createdBy   User  @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  updatedBy   User? @relation("InvoiceUpdatedBy", fields: [updatedById], references: [id])
  cancelledBy User? @relation("InvoiceCancelledBy", fields: [cancelledById], references: [id])
  archivedBy  User? @relation("InvoiceArchivedBy", fields: [archivedById], references: [id])

  @@unique([sequenceYear, sequenceNumber])
  @@index([clientId])
  @@index([status])
  @@index([paymentStatus])
  @@index([issueDate])
  @@index([dueDate])
  @@index([isArchived])
  @@index([createdAt])
}

model InvoiceItem {
  id        String @id @default(uuid())
  invoiceId String
  position  Int

  title        String
  description  String?
  quantity     Decimal @db.Decimal(12, 3)
  unit         String
  unitPriceHt  Decimal @db.Decimal(14, 2)
  discountRate Decimal @default(0) @db.Decimal(5, 2)
  vatRate      Decimal @default(20) @db.Decimal(5, 2)

  grossAmountHt  Decimal @db.Decimal(14, 2)
  discountAmount Decimal @db.Decimal(14, 2)
  netAmountHt    Decimal @db.Decimal(14, 2)
  vatAmount      Decimal @db.Decimal(14, 2)
  totalTtc       Decimal @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, position])
  @@index([invoiceId])
}

model Payment {
  id          String              @id @default(uuid())
  invoiceId   String
  amount      Decimal             @db.Decimal(14, 2)
  paymentDate DateTime
  method      PaymentMethod
  reference   String?
  notes       String?
  status      PaymentRecordStatus @default(CONFIRMED)

  reversedAt     DateTime?
  reversedById   String?
  reversalReason String?

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  invoice    Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  createdBy  User    @relation("PaymentCreatedBy", fields: [createdById], references: [id])
  reversedBy User?   @relation("PaymentReversedBy", fields: [reversedById], references: [id])

  @@index([invoiceId])
  @@index([paymentDate])
  @@index([method])
  @@index([status])
  @@index([createdAt])
}

model DocumentSequence {
  id         String   @id @default(uuid())
  type       String
  year       Int
  lastNumber Int      @default(0)
  updatedAt  DateTime @updatedAt

  @@unique([type, year])
}

enum CompanyAssetType {
  LOGO
  SIGNATURE
  STAMP
}

model CompanySettings {
  id           String @id @default(uuid())
  singletonKey String @unique @default("DEFAULT")

  legalName    String
  tradeName    String?
  legalForm    String?
  address      String?
  addressLine2 String?
  city         String?
  postalCode   String?
  country      String  @default("Maroc")

  ice    String?
  taxId  String?
  rc     String?
  cnss   String?
  patent String?

  phone          String?
  secondaryPhone String?
  email          String?
  website        String?

  bankName      String?
  accountHolder String?
  rib           String?
  iban          String?
  swiftBic      String?

  defaultCurrency          String  @default("MAD")
  defaultVatRate           Decimal @default(20) @db.Decimal(5, 2)
  defaultQuoteValidityDays Int     @default(30)
  defaultInvoiceDueDays    Int     @default(30)
  defaultPaymentTerms      String?
  defaultQuoteNotes        String?
  defaultInvoiceNotes      String?

  quotePrefix   String @default("DEV")
  invoicePrefix String @default("FAC")

  showSignatureOnPaidInvoice Boolean @default(true)
  showStampOnPaidInvoice     Boolean @default(true)
  showLogoOnDocuments        Boolean @default(true)

  activeLogoAssetId      String?
  activeSignatureAssetId String?
  activeStampAssetId     String?

  revision    Int      @default(1)
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  updatedBy User? @relation("SettingsUpdatedBy", fields: [updatedById], references: [id])
}

model CompanyAsset {
  id           String           @id @default(uuid())
  type         CompanyAssetType
  originalName String
  mimeType     String
  size         Int
  width        Int?
  height       Int?
  sha256       String
  data         Bytes
  isActive     Boolean          @default(true)
  uploadedById String
  createdAt    DateTime         @default(now())

  uploadedBy       User                      @relation("AssetUploadedBy", fields: [uploadedById], references: [id])
  documentVersions EmployeeDocumentVersion[] @relation("DocumentVersionAsset")

  @@index([type])
  @@index([sha256])
  @@index([createdAt])
}

enum EmploymentStatus {
  ACTIVE
  ONBOARDING
  SUSPENDED
  DEPARTED
  ARCHIVED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model Employee {
  id                           String           @id @default(uuid())
  tenantId                     String           @default("default-tenant")
  employeeNumber               String
  firstName                    String
  lastName                     String
  displayName                  String
  photoAssetId                 String?
  gender                       Gender?
  birthDate                    DateTime?
  birthPlace                   String?
  nationality                  String?          @default("Marocaine")
  cinEncrypted                 String?
  cinFingerprint               String?
  addressLine1                 String?
  addressLine2                 String?
  city                         String?
  postalCode                   String?
  country                      String           @default("Maroc")
  phonePrimary                 String
  phoneSecondary               String?
  personalEmail                String?
  professionalEmail            String?
  emergencyContactName         String?
  emergencyContactRelationship String?
  emergencyContactPhone        String?
  hireDate                     DateTime
  employmentStatus             EmploymentStatus @default(ACTIVE)
  departureDate                DateTime?
  departureReason              String?
  baseSalary                   Decimal?         @default(0) @db.Decimal(12, 2)
  salaryCurrency               String           @default("MAD")
  paymentMethod                PaymentMethod?
  bankName                     String?
  ribEncrypted                 String?
  cnssNumberEncrypted          String?
  internalNotes                String?
  attendancePinHash            String?
  linkedUserId                 String?          @unique
  createdById                  String
  updatedById                  String?
  archivedAt                   DateTime?
  archivedById                 String?
  archiveReason                String?
  createdAt                    DateTime         @default(now())
  updatedAt                    DateTime         @updatedAt
  version                      Int              @default(1)

  linkedUser User? @relation("UserEmployee", fields: [linkedUserId], references: [id], onDelete: SetNull)
  createdBy  User  @relation("EmployeeCreatedBy", fields: [createdById], references: [id])
  updatedBy  User? @relation("EmployeeUpdatedBy", fields: [updatedById], references: [id])
  archivedBy User? @relation("EmployeeArchivedBy", fields: [archivedById], references: [id])

  managedSites        WorkSite[]                    @relation("WorkSiteManager")
  managedDepartments  Department[]                  @relation("DepartmentManager")
  assignments         EmployeeAssignment[]          @relation("EmployeeAssignments")
  managedAssignments  EmployeeAssignment[]          @relation("AssignmentManager")
  contracts           EmploymentContract[]          @relation("EmployeeContracts")
  managedContracts    EmploymentContract[]          @relation("ContractManager")
  documents           EmployeeDocument[]            @relation("EmployeeDocuments")
  scheduledShifts     ScheduledShift[]              @relation("EmployeeScheduledShifts")
  availabilities      EmployeeAvailability[]
  attendanceEvents    AttendanceEvent[]
  attendanceDays      AttendanceDay[]
  attendanceAnomalies AttendanceAnomaly[]
  correctionRequests  AttendanceCorrectionRequest[]
  leaveBalances       LeaveBalance[]
  leaveRequests       LeaveRequest[]
  scopedLeavePolicies LeavePolicy[]                 @relation("LeavePolicyEmployeeScope")
  absenceRecords      AbsenceRecord[]

  @@unique([tenantId, employeeNumber])
  @@unique([tenantId, cinFingerprint])
  @@unique([tenantId, linkedUserId])
  @@index([tenantId])
  @@index([tenantId, employmentStatus])
  @@index([tenantId, archivedAt])
  @@index([tenantId, lastName, firstName])
  @@index([tenantId, hireDate])
}

enum SiteType {
  HEAD_OFFICE
  RESTAURANT
  CENTRAL_KITCHEN
  CATERING_SITE
  CLIENT_SITE
  WAREHOUSE
  OTHER
}

enum AssignmentType {
  PERMANENT
  TEMPORARY
  SECONDARY
  TRANSFER
  ACTING
}

enum ContractType {
  CDI
  CDD
  TEMPORARY
  INTERNSHIP
  PART_TIME
  OTHER
}

enum ContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
  RENEWED
  CANCELLED
}

enum DocumentCategory {
  CIN
  CONTRACT
  CNSS
  RIB
  MEDICAL
  DIPLOMA
  WARNING
  RESIGNATION
  TERMINATION
  WORK_PERMIT
  OTHER
}

model WorkSite {
  id                String    @id @default(uuid())
  tenantId          String    @default("default-tenant")
  code              String
  name              String
  type              SiteType  @default(OTHER)
  description       String?
  addressLine1      String?
  addressLine2      String?
  city              String?
  postalCode        String?
  country           String    @default("Maroc")
  phone             String?
  email             String?
  managerEmployeeId String?
  openingDate       DateTime?
  closingDate       DateTime?
  isActive          Boolean   @default(true)
  archivedAt        DateTime?
  archivedById      String?
  archiveReason     String?
  createdById       String
  updatedById       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  version           Int       @default(1)

  managerEmployee Employee? @relation("WorkSiteManager", fields: [managerEmployeeId], references: [id], onDelete: SetNull)
  createdBy       User      @relation("WorkSiteCreatedBy", fields: [createdById], references: [id])
  updatedBy       User?     @relation("WorkSiteUpdatedBy", fields: [updatedById], references: [id])
  archivedBy      User?     @relation("WorkSiteArchivedBy", fields: [archivedById], references: [id])

  assignments           EmployeeAssignment[]
  contracts             EmploymentContract[]
  shiftTemplates        ShiftTemplate[]
  schedules             WorkSchedule[]
  scheduledShifts       ScheduledShift[]
  staffingRequirements  StaffingRequirement[]
  schedulePolicy        SiteSchedulePolicy?
  attendancePolicies    AttendancePolicy[]
  attendanceTerminals   AttendanceTerminal[]
  attendanceEvents      AttendanceEvent[]
  attendanceDays        AttendanceDay[]
  attendanceAnomalies   AttendanceAnomaly[]
  correctionRequests    AttendanceCorrectionRequest[]
  attendanceValidations AttendanceValidation[]
  attendancePeriodLocks AttendancePeriodLock[]
  leavePolicies         LeavePolicy[]
  holidayCalendarSites  HolidayCalendarSite[]
  leaveRequestDays      LeaveRequestDay[]
  absenceRecords        AbsenceRecord[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([tenantId, type])
  @@index([tenantId, archivedAt])
}

model Department {
  id                String    @id @default(uuid())
  tenantId          String    @default("default-tenant")
  code              String
  name              String
  description       String?
  managerEmployeeId String?
  isActive          Boolean   @default(true)
  archivedAt        DateTime?
  archivedById      String?
  archiveReason     String?
  createdById       String
  updatedById       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  version           Int       @default(1)

  managerEmployee Employee? @relation("DepartmentManager", fields: [managerEmployeeId], references: [id], onDelete: SetNull)
