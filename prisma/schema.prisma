generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ACCOUNTANT
  COMMERCIAL
}

enum ClientType {
  COMPANY
  INDIVIDUAL
}

model User {
  id                 String     @id @default(uuid())
  name               String
  email              String     @unique
  passwordHash       String
  role               Role
  isActive           Boolean    @default(true)
  mustChangePassword Boolean    @default(false)
  passwordChangedAt  DateTime?
  deactivatedAt      DateTime?
  deactivatedById    String?
  lastLoginAt        DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  deactivatedBy     User?             @relation("UserDeactivatedBy", fields: [deactivatedById], references: [id])
  deactivatedUsers  User[]            @relation("UserDeactivatedBy")

  sessions          Session[]
  auditLogs         AuditLog[]
  createdClients    Client[]          @relation("ClientCreatedBy")
  updatedClients    Client[]          @relation("ClientUpdatedBy")
  createdQuotes     Quote[]           @relation("QuoteCreatedBy")
  updatedQuotes     Quote[]           @relation("QuoteUpdatedBy")
  createdInvoices   Invoice[]         @relation("InvoiceCreatedBy")
  updatedInvoices   Invoice[]         @relation("InvoiceUpdatedBy")
  cancelledInvoices Invoice[]         @relation("InvoiceCancelledBy")
  createdPayments   Payment[]         @relation("PaymentCreatedBy")
  reversedPayments  Payment[]         @relation("PaymentReversedBy")
  uploadedAssets    CompanyAsset[]    @relation("AssetUploadedBy")
  updatedSettings   CompanySettings[] @relation("SettingsUpdatedBy")

  @@index([email])
  @@index([role])
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
  @@index([userId])
}

model Client {
  id              String     @id @default(uuid())
  type            ClientType @default(COMPANY)
  companyName     String?
  firstName       String?
  lastName        String?
  displayName     String
  ice             String?
  taxId           String?
  rc              String?
  cnss            String?
  patent          String?
  email           String?
  phone           String?
  secondaryPhone  String?
  address         String?
  addressLine2    String?
  city            String?
  postalCode      String?
  country         String     @default("Maroc")
  contactName     String?
  contactPosition String?
  contactEmail    String?
  contactPhone    String?
  notes           String?
  isArchived      Boolean    @default(false)
  archivedAt      DateTime?
  createdById     String
  updatedById     String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  createdBy       User       @relation("ClientCreatedBy", fields: [createdById], references: [id])
  updatedBy       User?      @relation("ClientUpdatedBy", fields: [updatedById], references: [id])
  quotes          Quote[]
  invoices        Invoice[]

  @@index([displayName])
  @@index([companyName])
  @@index([firstName])
  @@index([lastName])
  @@index([ice])
  @@index([taxId])
  @@index([email])
  @@index([phone])
  @@index([city])
  @@index([isArchived])
  @@index([createdAt])
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

model Quote {
  id                    String       @id @default(uuid())
  number                String       @unique
  sequenceNumber        Int
  sequenceYear          Int

  clientId              String
  clientSnapshot        Json
  companySnapshot       Json?

  status                QuoteStatus  @default(DRAFT)

  issueDate             DateTime
  validUntil            DateTime

  currency              String       @default("MAD")
  defaultVatRate        Decimal?     @db.Decimal(5, 2)

  discountType          DiscountType?
  discountValue         Decimal?     @db.Decimal(12, 2)

  subtotalHt            Decimal      @db.Decimal(14, 2)
  discountAmount        Decimal      @default(0) @db.Decimal(14, 2)
  totalNetHt            Decimal      @db.Decimal(14, 2)
  totalVat              Decimal      @db.Decimal(14, 2)
  totalTtc              Decimal      @db.Decimal(14, 2)

  subject               String?
  paymentTerms          String?
  publicNotes           String?
  internalNotes         String?

  isArchived            Boolean      @default(false)
  archivedAt            DateTime?

  sentAt                DateTime?
  acceptedAt            DateTime?
  rejectedAt            DateTime?
  expiredAt             DateTime?
  convertedAt           DateTime?

  createdById           String
  updatedById           String?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  client                Client       @relation(fields: [clientId], references: [id])
  items                 QuoteItem[]
  invoice               Invoice?     @relation("QuoteToInvoice")
  createdBy             User         @relation("QuoteCreatedBy", fields: [createdById], references: [id])
  updatedBy             User?        @relation("QuoteUpdatedBy", fields: [updatedById], references: [id])

  @@unique([sequenceYear, sequenceNumber])
  @@index([clientId])
  @@index([status])
  @@index([issueDate])
  @@index([validUntil])
  @@index([isArchived])
  @@index([createdAt])
}

model QuoteItem {
  id              String   @id @default(uuid())
  quoteId         String
  position        Int

  title           String
  description     String?
  quantity        Decimal  @db.Decimal(12, 3)
  unit            String
  unitPriceHt     Decimal  @db.Decimal(14, 2)
  discountRate    Decimal  @default(0) @db.Decimal(5, 2)
  vatRate         Decimal  @default(20) @db.Decimal(5, 2)

  grossAmountHt   Decimal  @db.Decimal(14, 2)
  discountAmount  Decimal  @db.Decimal(14, 2)
  netAmountHt     Decimal  @db.Decimal(14, 2)
  vatAmount       Decimal  @db.Decimal(14, 2)
  totalTtc        Decimal  @db.Decimal(14, 2)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  quote           Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@unique([quoteId, position])
  @@index([quoteId])
}

enum InvoiceStatus {
  DRAFT
  FINALIZED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHEQUE
  CARD
  OTHER
}

enum PaymentRecordStatus {
  CONFIRMED
  REVERSED
}

model Invoice {
  id                    String          @id @default(uuid())

  number                String?         @unique
  sequenceNumber        Int?
  sequenceYear          Int?

  clientId              String
  sourceQuoteId         String?         @unique

  status                InvoiceStatus   @default(DRAFT)
  paymentStatus         PaymentStatus   @default(UNPAID)

  issueDate             DateTime
  dueDate               DateTime

  currency              String          @default("MAD")
  clientSnapshot        Json
  companySnapshot       Json

  discountType          DiscountType?
  discountValue         Decimal?        @db.Decimal(12, 2)

  subtotalHt            Decimal         @db.Decimal(14, 2)
  discountAmount        Decimal         @default(0) @db.Decimal(14, 2)
  totalNetHt            Decimal         @db.Decimal(14, 2)
  totalVat              Decimal         @db.Decimal(14, 2)
  totalTtc              Decimal         @db.Decimal(14, 2)

  amountPaid            Decimal         @default(0) @db.Decimal(14, 2)
  amountDue             Decimal         @db.Decimal(14, 2)

  subject               String?
  paymentTerms          String?
  publicNotes           String?
  internalNotes         String?

  finalizedAt           DateTime?
  cancelledAt           DateTime?
  cancellationReason    String?
  cancelledById         String?

  paidAt                DateTime?

  isArchived            Boolean         @default(false)
  archivedAt            DateTime?

  createdById           String
  updatedById           String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  client                Client          @relation(fields: [clientId], references: [id])
  sourceQuote           Quote?          @relation("QuoteToInvoice", fields: [sourceQuoteId], references: [id])
  items                 InvoiceItem[]
  payments              Payment[]

  createdBy             User            @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  updatedBy             User?           @relation("InvoiceUpdatedBy", fields: [updatedById], references: [id])
  cancelledBy           User?           @relation("InvoiceCancelledBy", fields: [cancelledById], references: [id])

  @@unique([sequenceYear, sequenceNumber])
  @@index([clientId])
  @@index([status])
  @@index([paymentStatus])
  @@index([issueDate])
  @@index([dueDate])
  @@index([isArchived])
  @@index([createdAt])
}

model InvoiceItem {
  id              String   @id @default(uuid())
  invoiceId       String
  position        Int

  title           String
  description     String?
  quantity        Decimal  @db.Decimal(12, 3)
  unit            String
  unitPriceHt     Decimal  @db.Decimal(14, 2)
  discountRate    Decimal  @default(0) @db.Decimal(5, 2)
  vatRate         Decimal  @default(20) @db.Decimal(5, 2)

  grossAmountHt   Decimal  @db.Decimal(14, 2)
  discountAmount  Decimal  @db.Decimal(14, 2)
  netAmountHt     Decimal  @db.Decimal(14, 2)
  vatAmount       Decimal  @db.Decimal(14, 2)
  totalTtc        Decimal  @db.Decimal(14, 2)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  invoice         Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, position])
  @@index([invoiceId])
}

model Payment {
  id                String              @id @default(uuid())
  invoiceId         String
  amount            Decimal             @db.Decimal(14, 2)
  paymentDate       DateTime
  method            PaymentMethod
  reference         String?
  notes             String?
  status            PaymentRecordStatus @default(CONFIRMED)

  reversedAt        DateTime?
  reversedById      String?
  reversalReason    String?

  createdById       String
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  invoice           Invoice             @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  createdBy         User                @relation("PaymentCreatedBy", fields: [createdById], references: [id])
  reversedBy        User?               @relation("PaymentReversedBy", fields: [reversedById], references: [id])

  @@index([invoiceId])
  @@index([paymentDate])
  @@index([method])
  @@index([status])
  @@index([createdAt])
}

model DocumentSequence {
  id          String   @id @default(uuid())
  type        String
  year        Int
  lastNumber  Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@unique([type, year])
}

enum CompanyAssetType {
  LOGO
  SIGNATURE
  STAMP
}

model CompanySettings {
  id                         String   @id @default(uuid())
  singletonKey               String   @unique @default("DEFAULT")

  legalName                  String
  tradeName                  String?
  legalForm                  String?
  address                    String?
  addressLine2               String?
  city                       String?
  postalCode                 String?
  country                    String   @default("Maroc")

  ice                        String?
  taxId                      String?
  rc                         String?
  cnss                       String?
  patent                     String?

  phone                      String?
  secondaryPhone             String?
  email                      String?
  website                    String?

  bankName                   String?
  accountHolder              String?
  rib                        String?
  iban                       String?
  swiftBic                   String?

  defaultCurrency            String   @default("MAD")
  defaultVatRate             Decimal  @default(20) @db.Decimal(5, 2)
  defaultQuoteValidityDays   Int      @default(30)
  defaultInvoiceDueDays      Int      @default(30)
  defaultPaymentTerms        String?
  defaultQuoteNotes          String?
  defaultInvoiceNotes        String?

  quotePrefix                String   @default("DEV")
  invoicePrefix              String   @default("FAC")

  showSignatureOnPaidInvoice Boolean  @default(true)
  showStampOnPaidInvoice     Boolean  @default(true)
  showLogoOnDocuments        Boolean  @default(true)

  activeLogoAssetId          String?
  activeSignatureAssetId     String?
  activeStampAssetId         String?

  revision                   Int      @default(1)
  updatedById                String?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  updatedBy                  User?    @relation("SettingsUpdatedBy", fields: [updatedById], references: [id])
}

model CompanyAsset {
  id           String           @id @default(uuid())
  type         CompanyAssetType
  originalName String
  mimeType     String
  size         Int
  width        Int?
  height       Int?
  sha256       String
  data         Bytes
  isActive     Boolean          @default(true)
  uploadedById String
  createdAt    DateTime         @default(now())

  uploadedBy   User             @relation("AssetUploadedBy", fields: [uploadedById], references: [id])

  @@index([type])
  @@index([sha256])
  @@index([createdAt])
}
